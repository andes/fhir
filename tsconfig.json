{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "src/demo",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "target": "es2020",
    "module": "commonjs",
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "jest"
    ]
  }
}
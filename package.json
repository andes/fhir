{
    "name": "@andes/fhir",
    "version": "0.0.0-development",
    "engines": {
        "node": ">=24.0.0"
    },
    "engineStrict": true,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "lint": "eslint \"src/**/*.ts\"",
        "tsc": "tsc",
        "tsc:w": "tsc -w",
        "test": "jest --coverage",
        "prepublishOnly": "rimraf dist && tsc -p ./ --outDir dist/",
        "build": "tsc -p ./ --outDir dist",
        "semantic-release": "semantic-release",
        "release:beta": "dotenv -e .env -- semantic-release",
        "release:beta:dry": "dotenv -e .env -- semantic-release --no-ci --dry-run",
        "release:prod": "dotenv -e .env -- semantic-release --branches master",
        "release:prod:dry": "dotenv -e .env -- semantic-release --no-ci --branches master --dry-run"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^24.0.0",
        "@typescript-eslint/eslint-plugin": "^8.26.0",
        "@typescript-eslint/parser": "^8.26.0",
        "dotenv-cli": "^11.0.0",
        "eslint": "^9.21.0",
        "jest": "^29.7.0",
        "rimraf": "^5.0.7",
        "semantic-release": "^20.1.0",
        "ts-jest": "^29.2.5",
        "typescript": "^5.8.2"
    },
    "dependencies": {
        "@types/fhir": "^0.0.41"
    },
    "files": [
        "dist/**/*"
    ],
    "release": {
        "branches": [
            {
                "name": "master"
            },
            {
                "name": "develop",
                "channel": "beta",
                "prerelease": "beta"
            }
        ]
    }
}